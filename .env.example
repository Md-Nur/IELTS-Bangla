# Neon PostgreSQL Database URL
# Example: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/ielts_bangla?sslmode=require"

# Alias if using legacy DATA_BASE
DATA_BASE="postgresql://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/ielts_bangla?sslmode=require"

# Session / JWT Secret for Authentication
AUTH_SECRET="your-super-secret-random-key-at-least-32-chars"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
